{
  "name": "jws-attendance",
  "version": "2.3.1",
  "private": true,
  "description": "Staff attendance management for Janapremi World School",
  "type": "module",
  "scripts": {
    "dev": "node build.mjs --watch --serve",
    "build": "node build.mjs",
    "tauri": "tauri",
    "start": "tauri dev",
    "package": "tauri build",
    "test": "node --test tests/*.test.js",
    "test:ui": "playwright test",
    "test:rust": "cargo test --workspace",
    "check": "npm run test:rust && npm run test && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@tauri-apps/cli": "^2.1.0",
    "esbuild": "^0.24.0",
    "tailwindcss": "^3.4.14"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.1.0",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@tauri-apps/plugin-opener": "^2.2.2",
    "@tauri-apps/plugin-updater": "^2.0.2"
  }
}
